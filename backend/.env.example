# Server
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI (required for real AI briefs)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_TOKENS=1800

# Supabase (backend uses service role — never expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: JWT secret from Project Settings → API. If omitted, the API verifies sessions via Auth.
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
# Optional: same anon/publishable key as the frontend; used only as Auth apikey fallback
SUPABASE_ANON_KEY=your-anon-key

# Counsellor access: comma-separated emails allowed after Supabase Auth sign-in
COUNSELLOR_EMAILS=counsellor@example.com

# Optional: assign experiment group randomly (treatment ratio 0-1)
EXPERIMENT_TREATMENT_RATIO=0.5

# Rate limiting
RATE_LIMIT_PER_MINUTE=30
